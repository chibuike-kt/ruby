# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
ENV=development

# --- Database ---
DATABASE_URL=postgres://ruby:ruby@localhost:5432/ruby?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API rate limiting (spec §35), requests per user per minute ---
RATE_LIMIT_PER_MINUTE=30

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- AI / Intent extraction (spec §9), OpenAI ---
AI_PROVIDER_API_KEY=
# Defaults to gpt-5.6-terra if unset. The transcription (gpt-transcribe)
# and response-phrasing (gpt-5.6-luna) models are fixed, not configurable
# here — see internal/ai/openai.
AI_MODEL=

# --- Auth ---
JWT_SIGNING_SECRET=

# --- Timezone used to resolve relative dates like "Friday" ---
DEFAULT_TIMEZONE=Africa/Lagos

# --- Reminder opt-in (spec §18/19 narrow slice) ---
# Meta-approved WhatsApp template name for debt-due reminders sent to
# customers. Defaults to "debt_reminder" if unset — a placeholder until
# a real template is submitted and approved; every send fails with a
# real Cloud API error until then (see internal/reminder).
WHATSAPP_REMINDER_TEMPLATE_NAME=

# --- Wema Credit Profile API partner auth (docs/wema-integration.md) ---
# Static bearer token for the demo; empty means the endpoint fails
# closed. In production this would be a proper OAuth2 client-credentials
# flow issued to Wema specifically, not a shared static secret.
WEMA_PARTNER_TOKEN=
