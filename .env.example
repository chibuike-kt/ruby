# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8080
ENV=development

# --- Database ---
DATABASE_URL=postgres://ruby:ruby@localhost:5432/ruby?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API rate limiting (spec §35), requests per user per minute ---
RATE_LIMIT_PER_MINUTE=30

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- AI / Intent extraction ---
AI_PROVIDER_API_KEY=
AI_MODEL=

# --- Auth ---
JWT_SIGNING_SECRET=

# --- Timezone used to resolve relative dates like "Friday" ---
DEFAULT_TIMEZONE=Africa/Lagos
